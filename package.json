{
  "name": "@openai/codex-plugin-cc",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "mkdir -p plugins/codex/.generated/app-server-types && codex app-server generate-ts --out plugins/codex/.generated/app-server-types",
    "build": "tsc -p tsconfig.app-server.json",
    "build:session-hook": "node scripts/build-session-hook.mjs",
    "check:session-hook": "node scripts/build-session-hook.mjs --check",
    "test": "npm run check:session-hook && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tree-sitter-bash": "0.25.1",
    "typescript": "^6.0.2",
    "web-tree-sitter": "0.27.2"
  }
}
